<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Hereda versiones de Spring Boot (dependencias y plugins) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>gt.cunoc.proyecto2</groupId>
    <artifactId>services</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Proyecto 2 - Servicios</name>
    <description>Monorepo de microservicios: transporte extraurbano</description>

    <!-- Orden de compilación: comun primero; Maven resuelve el resto por dependencias -->
    <modules>
        <module>comun</module>
        <module>api-gateway</module>
        <module>identity-service</module>
        <module>fleet-service</module>
        <module>trips-service</module>
        <module>sales-service</module>
        <module>maintenance-service</module>
        <module>reporting-service</module>
        <module>notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <springdoc.version>3.0.3</springdoc.version>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- Cobertura mínima de líneas que exige jacoco:check en mvn verify -->
        <jacoco.cobertura.minima>0.85</jacoco.cobertura.minima>                          <!-- unitarias (*Test) -->
        <jacoco.cobertura.minima.integracion>0.65</jacoco.cobertura.minima.integracion>  <!-- integración (*IT) -->
    </properties>

    <!-- Solo fija versiones; cada módulo declara lo que realmente usa -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>gt.cunoc.proyecto2</groupId>
                <artifactId>comun</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Heredado por todos los módulos: JUnit 5, Mockito, AssertJ, JsonPath, Awaitility, Spring Test -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  JaCoCo: se configura aquí una sola vez. Se ACTIVA en cada módulo agregando en su pom.xml:
                    <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId></plugin>

                  mvn test   -> unitarias              -> <modulo>/target/site/jacoco/index.html
                  mvn verify -> además integración      -> <modulo>/target/site/jacoco-it/index.html
                                y el total (las dos)    -> <modulo>/target/site/jacoco-total/index.html
                                y falla si unitarias < 85 % o integración < 65 %
                  Un módulo sin pruebas *IT (p. ej. comun) no genera jacoco-it.exec y esa verificación se omite.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <!-- Clases main de Spring Boot: no tienen lógica que probar -->
                            <exclude>**/*Application.class</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <!-- ===== 1. Unitarias (*Test.java, surefire) -> target/jacoco.exec ===== -->
                        <execution>
                            <id>preparar-agente</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>reporte</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>

                        <!-- ===== 2. Integración (*IT.java, failsafe) -> target/jacoco-it.exec ===== -->
                        <execution>
                            <id>preparar-agente-integracion</id>
                            <goals>
                                <goal>prepare-agent-integration</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>reporte-integracion</id>
                            <goals>
                                <goal>report-integration</goal>
                            </goals>
                        </execution>

                        <!-- ===== 3. Total: une los dos archivos (solo informativo) ===== -->
                        <execution>
                            <id>unir-cobertura</id>
                            <phase>post-integration-test</phase>
                            <goals>
                                <goal>merge</goal>
                            </goals>
                            <configuration>
                                <fileSets>
                                    <fileSet>
                                        <directory>${project.build.directory}</directory>
                                        <includes>
                                            <include>jacoco.exec</include>
                                            <include>jacoco-it.exec</include>
                                        </includes>
                                    </fileSet>
                                </fileSets>
                                <destFile>${project.build.directory}/jacoco-total.exec</destFile>
                            </configuration>
                        </execution>
                        <execution>
                            <id>reporte-total</id>
                            <phase>post-integration-test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <dataFile>${project.build.directory}/jacoco-total.exec</dataFile>
                                <outputDirectory>${project.reporting.outputDirectory}/jacoco-total</outputDirectory>
                            </configuration>
                        </execution>

                        <!-- ===== 4. Mínimos (mvn verify) ===== -->
                        <!-- Unitarias: mínimo ${jacoco.cobertura.minima} -->
                        <execution>
                            <id>verificar-cobertura</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.cobertura.minima}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                        <!-- Integración: mínimo ${jacoco.cobertura.minima.integracion} -->
                        <execution>
                            <id>verificar-cobertura-integracion</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <dataFile>${project.build.directory}/jacoco-it.exec</dataFile>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.cobertura.minima.integracion}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- mvn test    -> pruebas unitarias   (*Test.java, surefire)
                 mvn verify  -> además las de integración (*IT.java, failsafe; necesitan Docker) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>