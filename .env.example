# =====================================================================
# .env.example · DESARROLLO LOCAL (su máquina)
# Copiar a .env:   cp .env.example .env
# Docker Compose lo lee solo; NetBeans NO (los servicios usan los valores por defecto de su application.yml).
# El .env real NUNCA se sube a Git (está en .gitignore).
# Producción (VM de Azure): /opt/proyecto2/.env.prod, ver infra/azure.
# =====================================================================

# ---------- Entorno ----------
SPRING_PROFILE=dev
REGISTRY=ghcr.io/eilergomez          # siempre en minúsculas
IMAGE_TAG=latest
DB_SUFIJO=                           # vacío en local: bd_flota, bd_viajes, ...

# ---------- Puertos publicados en su máquina ----------
GATEWAY_PORT=8080
RABBIT_PORT=5672                     # el application.yml de cada servicio usa 5672
RABBIT_UI_PORT=15672                 # panel: http://localhost:15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025                 # buzón de prueba: http://localhost:8025

# ---------- Seguridad ----------
# Mismo valor en todos los servicios y en el gateway. Mínimo 32 caracteres.
# Generar uno:  openssl rand -base64 48   (el de producción es otro, distinto a este)
JWT_SECRET=solo-desarrollo-cambiar-este-secreto-de-32-caracteres
GATEWAY_SECURITY_ENABLED=true        # false solo para pruebas rápidas en desarrollo
FRONTEND_URL=http://localhost:4200   # front Angular (ng serve)
# Orígenes permitidos por CORS en el gateway, separados por coma.
GATEWAY_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ---------- PostgreSQL (instalado fuera de Docker) ----------
# host.docker.internal = "su máquina" vista desde un contenedor.
# Las contraseñas deben ser las mismas con que se crearon los usuarios (bd/00_crear_bases.sql).
DB_HOST=host.docker.internal
DB_POOL_MAX=10                       # conexiones por servicio; en producción (Azure B1ms) va 4
DB_IDENTIDAD_PASSWORD=cambiar_identidad
DB_FLOTA_PASSWORD=cambiar_flota
DB_VIAJES_PASSWORD=cambiar_viajes
DB_VENTAS_PASSWORD=cambiar_ventas
DB_MANTENIMIENTO_PASSWORD=cambiar_mantenimiento
DB_REPORTES_PASSWORD=cambiar_reportes
DB_NOTIFICACIONES_PASSWORD=cambiar_notificaciones

# ---------- RabbitMQ ----------
# Usuario y contraseña con que se CREA RabbitMQ la primera vez (cuando su volumen está vacío).
# Si los cambia después: docker compose down -v  (borra los datos de RabbitMQ) y vuelva a levantarlo.
# Deben coincidir con lo que usan los servicios: si corren desde NetBeans, sus valores por defecto son proyecto2/proyecto2.
RABBIT_USER=proyecto2
RABBIT_PASSWORD=proyecto2

# ---------- Fotos (Azure Blob Storage) · identity y fleet ----------
# URL de cada foto: <FOTOS_CUENTA_URL>/<FOTOS_CONTENEDOR>/<FOTOS_PREFIJO><carpeta>/<uuid>.<ext>
# FOTOS_PREFIJO=dev/ separa las fotos de prueba; en producción va vacío.
FOTOS_CUENTA_URL=https://stproyecto2fotos.blob.core.windows.net
FOTOS_CONTENEDOR=fotos
FOTOS_PREFIJO=dev/
# FOTOS_SAS: SOLO en local. Token SAS del contenedor "fotos" (permisos Crear, Escribir y Eliminar,
# solo HTTPS, con fecha de vencimiento). Pegarlo entre comillas simples, sin el "?" inicial:
#   FOTOS_SAS='sp=cwd&st=...&se=...&spr=https&sv=...&sr=c&sig=...'
# Nunca en Git ni en .env.prod: en la VM va vacío y se usa la identidad administrada.
FOTOS_SAS=

# ---------- Login con Google (opcional) ----------
# Sin client id y secret, el endpoint responde 503 y todo lo demás funciona igual.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir con una "Authorized redirect URI" de la credencial (pasa por el gateway).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/identity/auth/oauth2/google/callback
# Front al que vuelve el callback con ?ticket= o ?error=
OAUTH_FRONTEND_URL=http://localhost:4200

# ---------- Admin inicial (solo se crea si no hay ningún ADMIN_SISTEMA) ----------
# NIT y DPI son únicos: no usar "CF" como NIT del admin.
ADMIN_CORREO=
ADMIN_CONTRASENA=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Sistema
ADMIN_NIT=1000000-1
ADMIN_DPI=0000000000000
ADMIN_TELEFONO=00000000
ADMIN_DIRECCION=Ciudad

# ---------- Correo ----------
# Desarrollo: Mailpit (no envía nada, solo lo muestra en http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
# Gmail real (contraseña de aplicación de Google, requiere verificación en dos pasos):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=sucuenta@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_AUTH=true
# MAIL_STARTTLS=true
