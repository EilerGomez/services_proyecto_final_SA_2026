# =====================================================================
# .env.example · DESARROLLO LOCAL (su máquina)
# Copiar a .env:   cp .env.example .env
# Docker Compose lo lee solo; NetBeans NO (los servicios usan los valores por defecto de su application.yml).
# El .env real NUNCA se sube a Git (está en .gitignore).
# Para la VM de Google Cloud (producción) se usa infra/servidor/env.prod.plantilla.
# =====================================================================

# ---------- Entorno ----------
SPRING_PROFILE=dev
REGISTRY=ghcr.io/eilergomez          # siempre en minúsculas
IMAGE_TAG=latest
DB_SUFIJO=                           # vacío en local: bd_flota, bd_viajes, ...

# ---------- Puertos publicados en su máquina ----------
GATEWAY_PORT=8080
RABBIT_PORT=5672                     # el application.yml de cada servicio usa 5672
RABBIT_UI_PORT=15672                 # panel: http://localhost:15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025                 # buzón de prueba: http://localhost:8025

# ---------- Seguridad ----------
# Mismo valor en todos los servicios y en el gateway. Mínimo 32 caracteres.
# Generar uno:  openssl rand -base64 48
JWT_SECRET=solo-desarrollo-cambiar-este-secreto-de-32-caracteres
FRONTEND_URL=http://localhost:5173   # URL base usada en enlaces de correos (identity)
# Login con Google (opcional; sin estas dos el endpoint responde 503 y todo lo demás igual).
# Se crean en console.cloud.google.com (APIs y servicios > Credenciales, tipo Web) con:
#  Authorized redirect URI = GOOGLE_OAUTH_REDIRECT_URI (vía gateway).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/identity/auth/oauth2/google/callback
OAUTH_FRONTEND_URL=http://localhost:4200   # a dónde vuelve el callback con ?ticket= o ?error=
# Orígenes permitidos por CORS en el gateway (lista separada por comas).
# Debe incluir el puerto de cada frontend en desarrollo (Angular :4200, Vite :5173).
GATEWAY_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ---------- PostgreSQL (instalado fuera de Docker) ----------
# host.docker.internal = "su máquina" vista desde un contenedor.
# Las contraseñas deben ser las mismas con que se crearon los usuarios (bd/00_crear_bases.sql).
DB_HOST=host.docker.internal
DB_IDENTIDAD_PASSWORD=cambiar_identidad
DB_FLOTA_PASSWORD=cambiar_flota
DB_VIAJES_PASSWORD=cambiar_viajes
DB_VENTAS_PASSWORD=cambiar_ventas
DB_MANTENIMIENTO_PASSWORD=cambiar_mantenimiento
DB_REPORTES_PASSWORD=cambiar_reportes
DB_NOTIFICACIONES_PASSWORD=cambiar_notificaciones

# ---------- RabbitMQ ----------
# Usuario y contraseña con que se CREA RabbitMQ la primera vez (cuando su volumen está vacío).
# Si los cambia después: docker compose down -v  (borra los datos de RabbitMQ) y vuelva a levantarlo.
# Deben coincidir con lo que usan los servicios: si corren desde NetBeans, sus valores por defecto son proyecto2/proyecto2.
RABBIT_USER=proyecto2
RABBIT_PASSWORD=proyecto2

# ---------- Fotos (bucket de Google Cloud Storage) ----------
# Las credenciales NO van aquí. En su máquina: una vez  gcloud auth application-default login
# (si corren todo en Docker local, la subida de fotos no tiene credenciales: úsenla desde NetBeans).
FOTOS_BUCKET=proyecto-final-sa-fotos
FOTOS_PREFIJO=dev/                   # las fotos de pruebas locales quedan en la carpeta dev/ del bucket en producción va vacío (las fotos de producción van a la raíz del bucket)

# ---------- Correo ----------
# Desarrollo: Mailpit (no envía nada, solo lo muestra en http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
# Gmail real (contraseña de aplicación de Google, requiere verificación en dos pasos):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=sucuenta@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_AUTH=true
# MAIL_STARTTLS=true