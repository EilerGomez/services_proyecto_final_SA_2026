# ESTAS VARIABLES DE ENTORNO SON SÓLO PARA PRODUCCION CUANDO SE LEVANTAN EN LA VM, PARA PROBARLAS EN LOCAL USAR LAS VARIABLES DE ENTORNO DE CADA MICROSERVICIO EN APICATION.YML DE CADA UNA.

# Copiar a .env (local), .env.dev o .env.prod (VM). NUNCA subir los .env reales a Git.

# Entorno
SPRING_PROFILE=dev
IMAGE_TAG=develop                 # develop en DEV, latest en PROD
REGISTRY=ghcr.io/eilergomez       # ghcr.io/eilergomez en DEV y PROD
DB_SUFIJO=_dev                    # _dev -> bd_flota_dev ; vacío en PROD

# Puertos publicados en la máquina (cambian entre dev y prod en la misma VM)
GATEWAY_PORT=8090                 # 8080 en PROD
RABBIT_PORT=5673                  # 5672 en PROD
RABBIT_UI_PORT=15673              # 15672 en PROD
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# Seguridad
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
FRONTEND_URL=http://localhost:5173

# PostgreSQL (fuera de Docker)
DB_HOST=host.docker.internal
DB_IDENTIDAD_PASSWORD=cambiar_identidad
DB_FLOTA_PASSWORD=cambiar_flota
DB_VIAJES_PASSWORD=cambiar_viajes
DB_VENTAS_PASSWORD=cambiar_ventas
DB_MANTENIMIENTO_PASSWORD=cambiar_mantenimiento
DB_REPORTES_PASSWORD=cambiar_reportes
DB_NOTIFICACIONES_PASSWORD=cambiar_notificaciones

# RabbitMQ
RABBIT_USER=proyecto2
RABBIT_PASSWORD=cambiar_rabbit

# Correo (DEV: Mailpit; PROD: SMTP real, p. ej. smtp.gmail.com:587 con contraseña de aplicación)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=