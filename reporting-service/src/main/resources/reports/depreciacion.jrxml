<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="depreciacion" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="FROM_DATE" class="java.lang.String"/>
    <parameter name="TO_DATE" class="java.lang.String"/>
    <parameter name="TOTAL" class="java.lang.String"/>
    <parameter name="TARIFA_VIGENTE" class="java.lang.String"/>
    <field name="placa" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="kmRecorridos" class="java.math.BigDecimal"/>
    <field name="tarifa" class="java.math.BigDecimal"/>
    <field name="costo" class="java.math.BigDecimal"/>
    <title>
        <band height="100">
            <rectangle><reportElement x="0" y="0" width="555" height="55" backcolor="#0D1B2A" mode="Opaque"/></rectangle>
            <textField><reportElement x="0" y="6" width="555" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="36" width="555" height="16" forecolor="#CCCCCC"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{FROM_DATE} + "  al  " + $P{TO_DATE}]]></textFieldExpression></textField>
            <rectangle><reportElement x="0" y="62" width="370" height="32" backcolor="#E8F4FD" mode="Opaque"/></rectangle>
            <staticText><reportElement x="4" y="63" width="362" height="12" forecolor="#555555"/><textElement textAlignment="Center"><font size="7"/></textElement><text><![CDATA[Tarifa vigente]]></text></staticText>
            <textField><reportElement x="4" y="76" width="362" height="16" forecolor="#0D1B2A"/><textElement textAlignment="Center"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TARIFA_VIGENTE}]]></textFieldExpression></textField>
            <rectangle><reportElement x="377" y="62" width="178" height="32" backcolor="#1B5E20" mode="Opaque"/></rectangle>
            <staticText><reportElement x="381" y="63" width="170" height="12" forecolor="#C8E6C9"/><textElement textAlignment="Center"><font size="7"/></textElement><text><![CDATA[Depreciación total]]></text></staticText>
            <textField><reportElement x="381" y="76" width="170" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TOTAL}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="22">
            <rectangle><reportElement x="0" y="0" width="555" height="22" backcolor="#0D1B2A" mode="Opaque"/></rectangle>
            <staticText><reportElement x="5" y="3" width="80" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Bus]]></text></staticText>
            <staticText><reportElement x="88" y="3" width="80" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="8"/></textElement><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="171" y="3" width="110" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Km]]></text></staticText>
            <staticText><reportElement x="284" y="3" width="120" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Tarifa /km]]></text></staticText>
            <staticText><reportElement x="407" y="3" width="143" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true" size="8"/></textElement><text><![CDATA[Costo]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <rectangle><reportElement x="0" y="0" width="555" height="20" backcolor="#F4F6F8" mode="Opaque"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement></rectangle>
            <textField><reportElement x="5" y="2" width="80" height="16"/><textElement><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{placa}]]></textFieldExpression></textField>
            <textField><reportElement x="88" y="2" width="80" height="16"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="171" y="2" width="110" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{kmRecorridos}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.0000"><reportElement x="284" y="2" width="120" height="16"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{tarifa}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement x="407" y="2" width="143" height="16"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{costo}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter><band height="20">
        <textField><reportElement x="0" y="3" width="555" height="14"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band></pageFooter>
    <summary><band height="30">
        <line><reportElement x="0" y="2" width="555" height="1" forecolor="#0D1B2A"/></line>
        <staticText><reportElement x="284" y="6" width="120" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[TOTAL]]></text></staticText>
        <textField><reportElement x="407" y="6" width="143" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TOTAL}]]></textFieldExpression></textField>
    </band></summary>
    <noData><band height="40">
        <staticText><reportElement x="0" y="10" width="555" height="20"/><textElement textAlignment="Center"><font size="11" isItalic="true"/></textElement><text><![CDATA[No hay viajes completados para el período indicado.]]></text></staticText>
    </band></noData>
</jasperReport>
