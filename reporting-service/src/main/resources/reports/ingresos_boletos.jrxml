<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ingresos_boletos" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="FROM_DATE" class="java.lang.String"/>
    <parameter name="TO_DATE" class="java.lang.String"/>
    <parameter name="TOTAL" class="java.lang.String"/>
    <parameter name="BOLETOS_SUMMARY" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="ventaId" class="java.util.UUID"/>
    <field name="ruta" class="java.lang.String"/>
    <field name="busPlaca" class="java.lang.String"/>
    <field name="clienteNit" class="java.lang.String"/>
    <field name="movimiento" class="java.lang.String"/>
    <field name="boletos" class="java.lang.Integer"/>
    <field name="monto" class="java.math.BigDecimal"/>
    <title>
        <band height="96">
            <rectangle><reportElement x="0" y="0" width="555" height="72" backcolor="#0D1B2A" mode="Opaque"/></rectangle>
            <textField><reportElement x="0" y="6" width="555" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="36" width="555" height="16" forecolor="#CCCCCC"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Período: " + $P{FROM_DATE} + "  al  " + $P{TO_DATE} + "    ·    Total: " + $P{TOTAL}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="54" width="555" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{BOLETOS_SUMMARY}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="22">
            <rectangle><reportElement x="0" y="0" width="555" height="22" backcolor="#0D1B2A" mode="Opaque"/></rectangle>
            <staticText><reportElement x="5" y="3" width="50" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="7"/></textElement><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="58" y="3" width="130" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="7"/></textElement><text><![CDATA[Ruta]]></text></staticText>
            <staticText><reportElement x="191" y="3" width="55" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="7"/></textElement><text><![CDATA[Bus]]></text></staticText>
            <staticText><reportElement x="249" y="3" width="56" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="7"/></textElement><text><![CDATA[NIT]]></text></staticText>
            <staticText><reportElement x="308" y="3" width="82" height="16" forecolor="#FFFFFF"/><textElement><font isBold="true" size="7"/></textElement><text><![CDATA[Movimiento]]></text></staticText>
            <staticText><reportElement x="393" y="3" width="47" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true" size="7"/></textElement><text><![CDATA[Boletos]]></text></staticText>
            <staticText><reportElement x="443" y="3" width="107" height="16" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font isBold="true" size="7"/></textElement><text><![CDATA[Monto]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="32">
            <rectangle><reportElement x="0" y="0" width="555" height="32" backcolor="#F4F6F8" mode="Opaque"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement></rectangle>
            <textField><reportElement x="5" y="2" width="50" height="12"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="58" y="2" width="130" height="12"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{ruta}]]></textFieldExpression></textField>
            <textField><reportElement x="191" y="2" width="55" height="12"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{busPlaca}]]></textFieldExpression></textField>
            <textField><reportElement x="249" y="2" width="56" height="12"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{clienteNit}]]></textFieldExpression></textField>
            <textField><reportElement x="308" y="2" width="82" height="12"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{movimiento}]]></textFieldExpression></textField>
            <textField><reportElement x="393" y="2" width="47" height="12"/><textElement textAlignment="Right"><font size="6"/></textElement><textFieldExpression><![CDATA[$F{boletos}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement x="443" y="2" width="107" height="12"/><textElement textAlignment="Right"><font size="6" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="5" y="17" width="545" height="12"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA["Referencia de venta: " + $F{ventaId}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter><band height="20">
        <textField><reportElement x="0" y="3" width="555" height="14"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band></pageFooter>
    <summary><band height="30">
        <line><reportElement x="0" y="2" width="555" height="1" forecolor="#0D1B2A"/></line>
        <staticText><reportElement x="309" y="6" width="118" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[TOTAL]]></text></staticText>
        <textField><reportElement x="430" y="6" width="120" height="16"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TOTAL}]]></textFieldExpression></textField>
    </band></summary>
    <noData><band height="40">
        <staticText><reportElement x="0" y="10" width="555" height="20"/><textElement textAlignment="Center"><font size="11" isItalic="true"/></textElement><text><![CDATA[No se encontraron ingresos por boletos en el período indicado.]]></text></staticText>
    </band></noData>
</jasperReport>
