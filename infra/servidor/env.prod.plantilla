# =====================================================================
# .env.prod · VM de Google Cloud · entorno PROD
# Copiar en la VM:  /opt/proyecto2/.env.prod   (NO subir a Git)
# Las contraseñas de BD las imprime infra/servidor/03_crear_bases.sh
# =====================================================================

SPRING_PROFILE=prod
REGISTRY=ghcr.io/eilergomez
IMAGE_TAG=latest                         # imagen que publica el CI para esta rama
DB_SUFIJO=                           # vacío: bd_flota, bd_viajes, ...

GATEWAY_PORT=8080                      # único puerto abierto a internet de este entorno
RABBIT_PORT=5672                       # solo 127.0.0.1 (no se expone)
RABBIT_UI_PORT=15672                    # panel por túnel SSH
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# openssl rand -base64 48
JWT_SECRET=CAMBIAR
FRONTEND_URL=http://IP_O_DOMINIO_DEL_FRONTEND

DB_HOST=host.docker.internal
DB_IDENTIDAD_PASSWORD=CAMBIAR
DB_FLOTA_PASSWORD=CAMBIAR
DB_VIAJES_PASSWORD=CAMBIAR
DB_VENTAS_PASSWORD=CAMBIAR
DB_MANTENIMIENTO_PASSWORD=CAMBIAR
DB_REPORTES_PASSWORD=CAMBIAR
DB_NOTIFICACIONES_PASSWORD=CAMBIAR

# openssl rand -base64 24
RABBIT_USER=proyecto2
RABBIT_PASSWORD=CAMBIAR

# Fotos: bucket de Google Cloud Storage.
# Sin credenciales: la VM corre con la cuenta de servicio proyecto2-fotos y los contenedores
# obtienen el token del servidor de metadatos de GCP.
FOTOS_BUCKET=proyecto-final-sa-fotos
FOTOS_PREFIJO=                         # vacío en producción

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=sucuenta@gmail.com
MAIL_PASSWORD=CAMBIAR
MAIL_AUTH=true
MAIL_STARTTLS=true