# =====================================================================
# .env.prod · VM de Azure · PRODUCCIÓN
# Va en la VM:  /opt/proyecto2/.env.prod   (dueño deploy, permisos 600). NUNCA en Git.
# Reemplazar cada CAMBIAR. Sin comentarios al final de las líneas con secretos.
# =====================================================================

# ---------- Entorno ----------
SPRING_PROFILE=prod
REGISTRY=ghcr.io/eilergomez
IMAGE_TAG=latest
DB_SUFIJO=

# ---------- Red ----------
# Dominio de la VM: Caddy saca el certificado HTTPS para este nombre.
DOMINIO=transportes-proyecto2.eastus.cloudapp.azure.com
# El gateway solo en localhost: desde internet se entra por Caddy (443).
GATEWAY_PORT=127.0.0.1:8080
RABBIT_PORT=5672
RABBIT_UI_PORT=15672

# ---------- Seguridad ----------
# openssl rand -base64 48   (distinto al de desarrollo)
JWT_SECRET=CAMBIAR
GATEWAY_SECURITY_ENABLED=true
# URL del front (Static Web App), sin "/" al final
FRONTEND_URL=https://CAMBIAR.azurestaticapps.net
GATEWAY_ALLOWED_ORIGINS=https://CAMBIAR.azurestaticapps.net

# ---------- PostgreSQL (Azure Database for PostgreSQL, acceso privado) ----------
DB_HOST=psql-proyecto2.postgres.database.azure.com
# B1ms admite ~50 conexiones en total: 8 servicios x 4
DB_POOL_MAX=4
# Las líneas que imprimió 03_crear_bases.sh
DB_IDENTIDAD_PASSWORD=CAMBIAR
DB_FLOTA_PASSWORD=CAMBIAR
DB_VIAJES_PASSWORD=CAMBIAR
DB_VENTAS_PASSWORD=CAMBIAR
DB_MANTENIMIENTO_PASSWORD=CAMBIAR
DB_REPORTES_PASSWORD=CAMBIAR
DB_NOTIFICACIONES_PASSWORD=CAMBIAR
DB_CARTERA_PASSWORD=CAMBIAR

# ---------- RabbitMQ ----------
# Solo se aplica la primera vez que se crea su volumen.
# openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
RABBIT_USER=proyecto2
RABBIT_PASSWORD=CAMBIAR

# ---------- Fotos (Azure Blob Storage) ----------
# Sin SAS: se usa la identidad administrada de la VM. Prefijo vacío (las de prueba quedan en dev/).
FOTOS_CUENTA_URL=https://stproyecto2fotos.blob.core.windows.net
FOTOS_CONTENEDOR=fotos
FOTOS_PREFIJO=
FOTOS_SAS=

# ---------- Pagos (wallet-service) ----------
PAGOS_PROVEEDOR=simulado

# ---------- Login con Google ----------
GOOGLE_OAUTH_CLIENT_ID=CAMBIAR
GOOGLE_OAUTH_CLIENT_SECRET=CAMBIAR
# Agregar EXACTAMENTE esta URI en la credencial de Google ("URI de redireccionamiento autorizados")
GOOGLE_OAUTH_REDIRECT_URI=https://transportes-proyecto2.eastus.cloudapp.azure.com/identity/auth/oauth2/google/callback
OAUTH_FRONTEND_URL=https://CAMBIAR.azurestaticapps.net

# ---------- Admin inicial (ADMIN_SISTEMA + CLIENTE; solo si no hay ninguno) ----------
ADMIN_CORREO=CAMBIAR
ADMIN_CONTRASENA=CAMBIAR
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Sistema
ADMIN_NIT=1000000-1
ADMIN_DPI=0000000000000
ADMIN_TELEFONO=00000000
ADMIN_DIRECCION=Ciudad

# ---------- Correo (Gmail, contraseña de aplicación) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_AUTH=true
MAIL_STARTTLS=true
